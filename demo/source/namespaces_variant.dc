
typedef const char* String;

#pragma DCC push global $global_variant

#pragma DCC push get_string $get_string_variant

#pragma DCC push name$X$Y $ns$$X$Concat$_$$Y

#pragma DCC push ns 

int $ns$global()
{
	return 1;
}

#pragma DCC push ns $name$a

String $ns$get_string$T()
{
	return "a.$T";
}

#pragma DCC push ns $name$b

String $ns$get_string$T()
{
	return "a::b.$T";
}

#pragma DCC pop ns

#pragma DCC push ns $name$c

String $ns$get_string$T()
{
	return "a::c.$T";
}

#pragma DCC pop ns

#pragma DCC pop ns

String $ns$get_string$T()
{
	return ".$T";
}

#pragma DCC push ns $name$d_e

String $ns$get_string$T()
{
	return "d::e.$T";
}

#pragma DCC pop ns

#pragma DCC push ns $name$d_f

String $ns$get_string$T()
{
	return "d::f.$T";
}

#pragma DCC pop ns

#pragma region DEMO

#define CHECK_NAMESPACE(x, y) Assert(strcmp(x ## get_string_variant$TEST(), #y ".TEST") == 0)

void demo_namespaces_variant()
{
	Assert($global() == 1);

	Assert($ns$global() == 1);

	CHECK_NAMESPACE(a_, a);

	CHECK_NAMESPACE(a_b_, a::b);

	CHECK_NAMESPACE(a_c_, a::c);

	CHECK_NAMESPACE(, );

	CHECK_NAMESPACE(d_e_, d::e);

	CHECK_NAMESPACE(d_f_, d::f);
}

#undef CHECK_NAMESPACE

#pragma DCC pop global

#pragma DCC pop get_string

#pragma DCC pop ns

#pragma DCC pop name

#pragma endregion
