#pragma once

#pragma DTC push Swap$X$Y $$Y$$X

#pragma DTC push Concat$X$Y $X$Y

#pragma DTC push Forward$X $$X

#pragma DTC push Repeat$X $X$X$X

#pragma region DEMO

#pragma DTC push to_int$X (int)$X

void test_values$A$B()
{
	Assert($to_int$A == $to_int$B);
}

#pragma DTC push const_int $Forward$$Const$int

void test_declarations()
{
	int aaabbb = 1;

	Assert($Concat$$Repeat$a$Forward$bbb == 1);

	$Forward$Forward$const_int const_int = 2;

	Assert(const_int == 2);
}

#pragma DTC push stringify$X$Y "$X$Y"

#pragma DTC push compare_messages$X$Y strcmp(message_$X, message_$Y) == 0

#pragma DTC push eval_now$X $$X

#pragma DTC push append_eat$X $eval_now$$Concat$$X$eat

void test_strings()
{
	const char* message_1 = "$Concat$Swap$$Concat$Swap$a$b$$Concat$Swap$c$d";

	const char* message_2 = $stringify$dc$ba;

	Assert($compare_messages$1$2);

	const char* message_3 = "$Forward$$append_eat$Rep$a";

	const char* message_4 = "aaa";

	Assert($compare_messages$3$4);
}

enum
{
	ENUM_$X = $Concat$1$X
};

#pragma DTC instantiate ENUM_$1

#pragma DTC instantiate ENUM_$2

enum
{
	SPECIAL_1_$$3 = 13
};

enum
{
	SPECIAL_1_$$4 = 14
};

enum
{
	SPECIAL_1_$$$1$$5 = 15
};

#pragma DTC instantiate SPECIAL_1_$*

enum
{
	SPECIAL_2_$$$1$$6 = 16
};

#pragma DTC instantiate SPECIAL_2_$$$*$$*

enum
{
	SPECIAL_3_$X$$7 = $X + 7
};

enum
{
	SPECIAL_3_$X$$8 = $X + 8
};

#pragma DTC instantiate SPECIAL_3_$$$Add$1$9$*

#pragma DTC quote

const int global_constant_11 = ENUM_$1;

const int global_constant_12 = ENUM_$2;

const int global_constant_13 = SPECIAL_1_$3;

const int global_constant_14 = SPECIAL_1_$4;

const int global_constant_15 = SPECIAL_1_$$1$5;

const int global_constant_16 = SPECIAL_2_$$1$6;

const int global_constant_17 = SPECIAL_3_$$$Add$1$9$7;

const int global_constant_18 = SPECIAL_3_$$$Add$1$9$8;

void test_constants()
{
	Assert(global_constant_11 == 11);

	Assert(global_constant_12 == 12);

	Assert(global_constant_13 == 13);

	Assert(global_constant_14 == 14);
}

#pragma DTC unquote

#pragma DTC quote TAG_Ref$double

#pragma DTC quote TAG_Ref$char

enum
{
	TAG_int,

	TAG_float,

	TAG_Ref$double,

	TAG_Ref$char,

	TAG_COUNT
};

#pragma DTC quote get_index_Ref$double

#pragma DTC quote get_index_Ref$char

int get_index_int()
{
	return TAG_int;
}

int get_index_float()
{
	return TAG_float;
}

int get_index_Ref$double()
{
	return TAG_Ref$double;
}

int get_index_Ref$char()
{
	return TAG_Ref$char;
}

#pragma DTC unquote TAG_Ref$double

#pragma DTC unquote TAG_Ref$char

int get_tag$T()
{
	return $Concat$get_index_$T();
}

#pragma DTC unquote get_index_Ref$double

#pragma DTC unquote get_index_Ref$char

void test_template_suppression()
{
	Assert(get_tag$int() == 0);

	Assert(get_tag$float() == 1);

	Assert(get_tag$$Ref$double() == 2);

	Assert(get_tag$$Ref$char() == 3);
}

const char* global_string_1 = "test $Concat$1$2";

#pragma DTC quote $Concat$1$2

const char* global_string_2 = "test $Concat$1$2";

#pragma DTC unquote $Concat$1$2

void test_macro_suppression()
{
	Assert(strcmp(global_string_1, global_string_2) != 0);
}

#pragma DTC push square$X $$$Multiply$$X$$X

#pragma DTC push cube$X $$$$Multiply$$X$$X$$X

void demo_macros()
{
	test_values$square$5$$$Add$cube$3$$Negate$2();

	test_values$$$Swap$1$Increment$2();

	test_declarations();

	test_strings();

	test_constants();

	test_template_suppression();

	test_macro_suppression();
}

#pragma DTC pop square

#pragma DTC pop cube

#pragma endregion
